# Copy to .env.docker and replace these local-only values.
# Use a URL-safe password because Compose includes it in DATABASE_URL.
LOCAL_POSTGRES_PASSWORD=replace-with-local-password
API_BEARER_TOKEN=replace-with-at-least-32-random-characters
# Set a real key before running ingest-sources or generating chat answers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LOCAL_POSTGRES_PORT=55432
LOCAL_WEB_PORT=8000
