LLM_API_KEY=your_llm_api_key
LLM_MODEL=gpt-4.1-mini
SOURCES_DIRECTORY=sources
EMBEDDING_MODEL=text-embedding-3-large
DATABASE_URL=postgresql+psycopg://rag_user:change_me@localhost:5432/grounded_rag
API_BEARER_TOKEN=replace-with-at-least-32-random-characters
LOCAL_POSTGRES_PASSWORD=replace-with-local-password
LOCAL_POSTGRES_PORT=55432
LOCAL_POSTGRES_DB=grounded_rag
LOCAL_WEB_PORT=8000
CHAT_PURGE_MIN_AGE_DAYS=29
CHAT_PURGE_BATCH_SIZE=500
RETRIEVAL_COUNT=4
RETRIEVAL_RELEVANCE_THRESHOLD=0.2
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
EMBEDDING_BATCH_SIZE=100
INGESTION_MAX_ATTEMPTS=2
S3_SOURCE_BUCKET=
S3_SOURCE_PREFIX=
AWS_REGION=
MAX_DOCUMENT_SIZE_BYTES=104857600

# Optional OpenAI-compatible provider endpoints (defaults use OpenAI).
# LLM_BASE_URL=https://your-provider.example/v1
# EMBEDDING_BASE_URL=https://your-embedding-provider.example/v1
# EMBEDDING_API_KEY=your_embedding_api_key

# Native chat backend: openai (default), anthropic, or ollama
LLM_PROVIDER=openai
